# Smart-contract testnet configuration.
#
# Copy this file to `.env` and fill in your own values.
# Never commit the `.env` file — it is gitignored.

# Alchemy (or other provider) RPC endpoints. The URLs below are placeholders;
# replace the API key segment with your own key from https://alchemy.com.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<YOUR_API_KEY>
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/<YOUR_API_KEY>

# Funded test wallet private keys (testnet only, never mainnet).
# Generate fresh accounts for this purpose; do not reuse mainnet keys.
PRIVATE_KEY=0x<YOUR_TEST_PRIVATE_KEY>
PRIVATE_KEY_1=0x<YOUR_TEST_PRIVATE_KEY_RELAY_1>
PRIVATE_KEY_2=0x<YOUR_TEST_PRIVATE_KEY_RELAY_2>
